{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "label": "npm: watch",
      "detail": "esbuild in watch mode (dist/extension.js)",
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "never", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "esbuild",
        "fileLocation": "relative",
        "pattern": [
          { "regexp": "^✘ \\[ERROR\\] (.*)$", "message": 1 },
          { "regexp": "^\\s*$" },
          { "regexp": "^\\s+(.+):(\\d+):(\\d+):$", "file": 1, "line": 2, "column": 3 }
        ],
        "background": {
          "activeAtBegin": true,
          "beginsPattern": "\\[watch\\] build started",
          "endsPattern": "\\[watch\\] build finished"
        }
      }
    },
    {
      "type": "npm",
      "script": "test:watch",
      "label": "npm: test:watch",
      "detail": "vitest in watch mode",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "check",
      "label": "npm: check",
      "detail": "lint, typecheck, unit tests and the notices check",
      "group": "test",
      "problemMatcher": ["$tsc"]
    }
  ]
}
