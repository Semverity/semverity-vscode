{
  // "Run Extension" starts a second VS Code window (the Extension Development
  // Host) with this extension loaded from dist/. Open a sample folder in that
  // window to try it (see CONTRIBUTING.md, "Manual smoke check").
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "sourceMaps": true,
      "preLaunchTask": "npm: watch"
    },
    {
      "name": "Run Extension (other extensions disabled)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "--disable-extensions"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "sourceMaps": true,
      "preLaunchTask": "npm: watch"
    }
  ]
}
